# trip-planner 密钥配置模板
#
# 复制为 .env 后填入真实值：
#   cp .env.example .env
#
# .env 已被仓库根 .gitignore 排除，不会入库。

# ---------- 高德地图 ----------
# 两类 Key 不能互通：用错会返回 USERKEY_PLAT_NOMATCH(10009)。
# 申请：https://console.amap.com/dev/key/app（同一账号建两个应用即可，免费）

# ① 服务端地理编码 —— 应用类型必须选【Web 服务】
#    缺失影响：地点转不了坐标，地图上没有标记
AMAP_KEY=

# ② 浏览器加载底图 —— 应用类型必须选【Web 端 (JS API)】
#    缺失影响：地图底图一片空白
AMAP_JS_KEY=

# ② 配套安全密钥 securityJsCode —— 在 AMAP_JS_KEY 的 Key 详情页获取
#    2021-12-02 之后申请的 JS API Key 必须配置此项
AMAP_SECURITY=

# ---------- anysearch ----------
# 城市调研搜索。不配则走匿名，QPS 极低、容易 429。
# 申请：https://anysearch.com/console/api-keys
ANYSEARCH_API_KEY=

# ---------- 可选 ----------
# 产物输出目录，默认为当前工作目录下的 outputs/
# OUTPUT_DIR=
